{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucent",
  "version": "1.0.0",
  "identifier": "com.d4n87.lucent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lucent",
        "width": 1640,
        "height": 860,
        "minWidth": 1240,
        "minHeight": 640,
        "backgroundColor": "#0b0b0f",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
